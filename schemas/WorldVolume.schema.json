{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldVolume",
  "description": "A volume (world + 0x68/0x6C): a sphere or a BSP. Triggers (\"airboxes\") and the volume grid refer to them; `data` depends on the type.",
  "type": "object",
  "x-c-struct": "WorldVolume",
  "x-header": "World.h",
  "x-size": "0x30",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path or URL of this schema"
    },
    "format_version": {
      "const": 1
    },
    "extends": {
      "type": "string",
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "WorldVolume"
      },
      "description": "the object this one overrides (README \u00a710.3); fields left out, and the hidden ones, come from it"
    },
    "unk_0x00": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 4,
      "maxItems": 4,
      "x-offset": "0x00",
      "x-c-type": "u8[4]",
      "x-c-name": "pad0"
    },
    "enabled": {
      "description": "airboxes: 1 when on (ActionAirboxChangeMode)",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x04",
      "x-c-type": "u32"
    },
    "shape": {
      "description": "0: BSP, 1: sphere",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "x-offset": "0x08",
      "x-c-type": "s32"
    },
    "type": {
      "description": "VOLUME_*",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x0C",
      "x-c-type": "u32"
    },
    "center": {
      "description": "sphere",
      "$ref": "#/$defs/Vector4",
      "x-offset": "0x10",
      "x-c-type": "Vector4"
    },
    "radius": {
      "type": "number",
      "x-offset": "0x20",
      "x-c-type": "f32"
    },
    "radiusSq": {
      "type": "number",
      "x-offset": "0x24",
      "x-c-type": "f32"
    },
    "bsp": {
      "description": "BSP shape",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "void"
      },
      "x-offset": "0x28",
      "x-c-type": "PTR32(void)"
    },
    "data": {
      "description": "settings, by type",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "void"
      },
      "x-offset": "0x2C",
      "x-c-type": "PTR32(void)"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version"
  ],
  "if": {
    "required": [
      "extends"
    ]
  },
  "then": true,
  "else": {
    "required": [
      "unk_0x00",
      "enabled",
      "shape",
      "type",
      "center",
      "radius",
      "radiusSq",
      "bsp",
      "data"
    ]
  },
  "$defs": {
    "Vector4": {
      "title": "Vector4",
      "type": "object",
      "x-c-struct": "Vector4",
      "x-header": "common.h",
      "x-size": "0x10",
      "properties": {
        "x": {
          "type": "number",
          "x-offset": "0x00",
          "x-c-type": "f32"
        },
        "y": {
          "type": "number",
          "x-offset": "0x04",
          "x-c-type": "f32"
        },
        "z": {
          "type": "number",
          "x-offset": "0x08",
          "x-c-type": "f32"
        },
        "w": {
          "type": "number",
          "x-offset": "0x0C",
          "x-c-type": "f32"
        }
      },
      "additionalProperties": false
    }
  }
}
