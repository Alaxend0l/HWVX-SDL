{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Mod.schema.json",
  "title": "Mod",
  "description": "A mod's mod.jsonc (docs/xdl-format README §8). It never holds game data: it names base data by id and says what to change. Checked and packed by tools/xdl_mod.py, applied by src/game/Port_Mods.c.",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "name",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/uid"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "releases": {
      "description": "The releases it applies to (default: all).",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "gc",
          "pc",
          "ps2"
        ]
      }
    },
    "after": {
      "description": "Mods this one loads after.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/uid"
      }
    },
    "cars": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry",
        "properties": {
          "extends": {
            "pattern": "^base://HW_Cars/car_[0-9]+$"
          }
        }
      }
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry",
        "properties": {
          "extends": {
            "pattern": "^base://mcp/item/[0-9]+$"
          }
        }
      }
    },
    "patches": {
      "description": "Merge patches (RFC 7396) on base objects, by object id: base://HW_Cars/car_7/CarAInfo/0/accel.",
      "type": "object",
      "propertyNames": {
        "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/[A-Za-z0-9_]+/[0-9]+(/[A-Za-z0-9_]+)*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "recipes": {
      "description": "Colour recipes on base textures, by texture id: base://HW_Cars/car_7/texture/1 (or texture/gc:1 for one release's).",
      "type": "object",
      "propertyNames": {
        "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/texture/([a-z0-9]+:)?[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/recipe"
      }
    },
    "sounds": {
      "description": "The mod's own sound files over base sounds, by sound id: base://HW_Cars/car_7/sound/3 (or sound/gc:3 for one release's). The port decodes the file (WAV, FLAC, Ogg Vorbis, MP3) as the pack loads, mixes it to mono and resamples it to the base sound's rate. Loop: the file's tag (WAV smpl; LOOPSTART with LOOPLENGTH or LOOPEND as Vorbis comments or ID3v2 TXXX), else \"loop\", else the whole sound when the base sound loops.",
      "type": "object",
      "propertyNames": {
        "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/sound/([a-z0-9]+:)?[0-9]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "\\.(wav|flac|ogg|mp3|WAV|FLAC|OGG|MP3)$",
            "description": "the sound file, a path in the mod"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "\\.(wav|flac|ogg|mp3|WAV|FLAC|OGG|MP3)$",
                "description": "the sound file, a path in the mod"
              },
              "loop": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "loop start in the file's samples (null: plays once); a loop tag in the file wins"
              }
            }
          }
        ]
      }
    },
    "tracks": {
      "description": "New tracks: each a level of its base track's mode and an entry of that mode's world select.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uid"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "extends"
        ],
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string",
            "pattern": "^base://mcp/track/[0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/texture/([a-z0-9]+:)?[0-9]+$"
          },
          "unlocked": {
            "type": "boolean"
          },
          "world": {
            "type": "string",
            "description": "The world archive its level loads, as the MCP names one (worlds_\\\\sp_\\\\chal1_\\\\ch1_l2); default: the base track's."
          },
          "level": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+\\.json$",
            "description": "A level of its own over the world (tools/xdl_level.py compile; src/game/Port_Level.c): a file in the mod's folder. Default: the base track's level as it is."
          },
          "worldPack": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+\\.(xgc|xpc|xps)$",
            "description": "The level's own world pack, built on the player's machine from their data (tools/xdl_level_pack.py; never shipped): a file in the mod's folder that the track loads in place of its base world pack."
          }
        }
      }
    },
    "music": {
      "description": "Streamed music (docs-pending/streamed-music.md): base songs replaced by recorded tracks, by song id (base://ch1_l2/world_0/song/0, base://HW_music/music_1/song/0; the /song/0 may be left out). One track loops; a list is a playlist, each played through in turn.",
      "type": "object",
      "propertyNames": {
        "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+(/song/0)?$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/musicTrack"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/musicTrack"
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^uid://[0-9a-z]{1,13}$"
    },
    "entry": {
      "description": "A new car or item made from a base one: its pack, with patches and recipes of its own.",
      "type": "object",
      "required": [
        "extends"
      ],
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string",
          "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/texture/([a-z0-9]+:)?[0-9]+$"
        },
        "unlocked": {
          "type": "boolean"
        },
        "patch": {
          "description": "Merge patches on objects of the entry's own pack: CarAInfo/0/engine.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_]+/[0-9]+(/[A-Za-z0-9_]+)*$"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "recipes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^texture/([a-z0-9]+:)?[0-9]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/recipe"
          }
        }
      }
    },
    "recipe": {
      "description": "Colour operations applied in order, as one 3x4 matrix.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "oneOf": [
          {
            "properties": {
              "op": {
                "const": "hue_shift"
              },
              "degrees": {
                "type": "number"
              }
            },
            "required": [
              "degrees"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "tint"
              },
              "color": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "color"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "saturation"
              },
              "amount": {
                "type": "number"
              }
            },
            "required": [
              "amount"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "brightness"
              },
              "amount": {
                "type": "number"
              }
            },
            "required": [
              "amount"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "matrix"
              },
              "rows": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            },
            "required": [
              "rows"
            ]
          }
        ]
      }
    },
    "musicTrack": {
      "description": "A recorded track: a file of the mod's own (OGG, MP3, FLAC or WAV), or an object with its loop points.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./ -]+\\.(ogg|mp3|flac|wav)$"
        },
        {
          "type": "object",
          "required": [
            "file"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./ -]+\\.(ogg|mp3|flac|wav)$"
            },
            "loopStart": {
              "type": "integer",
              "minimum": 0,
              "description": "Where the loop starts, in the file's sample frames. Default: its LOOPSTART tag (or <file>.loop.txt), else 0."
            },
            "loopEnd": {
              "type": "integer",
              "minimum": 1,
              "description": "Where it jumps back to loopStart, in sample frames. Default: its LOOPEND (or LOOPSTART + LOOPLENGTH) tag, else the end."
            },
            "loop": {
              "type": "boolean",
              "description": "false: played once, then silence (a single track). Default true."
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 4,
              "description": "A gain on the track, under the game's music volume. Default 1."
            }
          }
        }
      ]
    }
  }
}
