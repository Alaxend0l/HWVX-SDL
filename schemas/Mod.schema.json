{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Mod.schema.json",
  "title": "Mod",
  "description": "A mod's mod.jsonc (docs/xdl-format README \u00a78). It never holds game data: it names base data by id and says what to change. Checked and packed by tools/xdl_mod.py, applied by src/game/Port_Mods.c.",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "name",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/uid"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "releases": {
      "description": "The releases it applies to (default: all).",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "gc",
          "pc",
          "ps2"
        ]
      }
    },
    "after": {
      "description": "Mods this one loads after.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/uid"
      }
    },
    "cars": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry",
        "properties": {
          "extends": {
            "pattern": "^base://HW_Cars/car_[0-9]+$"
          }
        }
      }
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry",
        "properties": {
          "extends": {
            "pattern": "^base://mcp/item/[0-9]+$"
          }
        }
      }
    },
    "patches": {
      "description": "Merge patches (RFC 7396) on base objects, by object id: base://HW_Cars/car_7/CarAInfo/0/accel.",
      "type": "object",
      "propertyNames": {
        "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/[A-Za-z0-9_]+/[0-9]+(/[A-Za-z0-9_]+)*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "recipes": {
      "description": "Colour recipes on base textures, by texture id: base://HW_Cars/car_7/texture/1 (or texture/gc:1 for one release's).",
      "type": "object",
      "propertyNames": {
        "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/texture/([a-z0-9]+:)?[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/recipe"
      }
    },
    "tracks": {
      "description": "New tracks: each a level of its base track's mode and an entry of that mode's world select.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uid"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "extends"
        ],
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string",
            "pattern": "^base://mcp/track/[0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/texture/([a-z0-9]+:)?[0-9]+$"
          },
          "unlocked": {
            "type": "boolean"
          },
          "world": {
            "type": "string",
            "description": "The world archive its level loads, as the MCP names one (worlds_\\\\sp_\\\\chal1_\\\\ch1_l2); default: the base track's."
          }
        }
      }
    }
  },
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^uid://[0-9a-z]{1,13}$"
    },
    "entry": {
      "description": "A new car or item made from a base one: its pack, with patches and recipes of its own.",
      "type": "object",
      "required": [
        "extends"
      ],
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string",
          "pattern": "^base://[A-Za-z0-9_]+/[a-z_]+_[0-9]+/texture/([a-z0-9]+:)?[0-9]+$"
        },
        "unlocked": {
          "type": "boolean"
        },
        "patch": {
          "description": "Merge patches on objects of the entry's own pack: CarAInfo/0/engine.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_]+/[0-9]+(/[A-Za-z0-9_]+)*$"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "recipes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^texture/([a-z0-9]+:)?[0-9]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/recipe"
          }
        }
      }
    },
    "recipe": {
      "description": "Colour operations applied in order, as one 3x4 matrix.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "oneOf": [
          {
            "properties": {
              "op": {
                "const": "hue_shift"
              },
              "degrees": {
                "type": "number"
              }
            },
            "required": [
              "degrees"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "tint"
              },
              "color": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "color"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "saturation"
              },
              "amount": {
                "type": "number"
              }
            },
            "required": [
              "amount"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "brightness"
              },
              "amount": {
                "type": "number"
              }
            },
            "required": [
              "amount"
            ]
          },
          {
            "properties": {
              "op": {
                "const": "matrix"
              },
              "rows": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            },
            "required": [
              "rows"
            ]
          }
        ]
      }
    }
  }
}
