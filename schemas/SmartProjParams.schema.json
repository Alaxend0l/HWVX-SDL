{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartProjParams",
  "description": "Homing parameters (ProjectileInfo.smart), SmartProjectiles.c.",
  "type": "object",
  "x-c-struct": "SmartProjParams",
  "x-header": "Projectile.h",
  "x-size": "0x24",
  "x-hidden": [
    {
      "offset": "0x00",
      "size": 1,
      "c-name": "pad00",
      "note": "never read (GC, PC, PS2)"
    },
    {
      "offset": "0x18",
      "size": 4,
      "c-name": "pad18",
      "note": "never read (GC, PC, PS2)"
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path or URL of this schema"
    },
    "format_version": {
      "const": 1
    },
    "extends": {
      "type": "string",
