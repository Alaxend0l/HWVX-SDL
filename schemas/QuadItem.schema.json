{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuadItem",
  "description": "A pickup spawn point of a quadrant (ItemThing.spawner).",
  "type": "object",
  "x-c-struct": "QuadItem",
  "x-header": "World.h",
  "x-size": "0x40",
  "properties": {
