    },
    "format_version": {
      "const": 1
    },
    "extends": {
      "type": "string",
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "QuadItem"
      },
      "description": "the object this one overrides (README \u00a710.3); fields left out, and the hidden ones, come from it"
    },
    "pos": {
      "$ref": "#/$defs/Vector4",
      "x-offset": "0x00",
      "x-c-type": "Vector4"
    },
    "unk_0x10": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 4,
      "maxItems": 4,
      "x-offset": "0x10",
      "x-c-type": "u8[4]",
      "x-c-name": "pad10"
    },
    "respawn": {
      "description": "ms before it respawns once taken, 0: never",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "x-offset": "0x14",
      "x-c-type": "s32"
    },
    "timer": {
      "description": "ms until it spawns",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "x-offset": "0x18",
      "x-c-type": "s32"
    },
    "record": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "ItemRecord"
      },
      "x-offset": "0x1C",
      "x-c-type": "PTR32(ItemRecord)"
    },
    "drawDist": {
      "description": "used if hasDrawDist",
      "type": "number",
      "x-offset": "0x20",
      "x-c-type": "f32"
    },
    "thing": {
      "description": "the spawned item",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
