      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x39",
      "x-c-type": "u8"
    },
    "unk_0x3A": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 6,
      "maxItems": 6,
      "x-offset": "0x3A",
      "x-c-type": "u8[6]",
      "x-c-name": "pad3A"
    }
