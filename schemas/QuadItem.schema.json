        "kind": "object",
        "target": "ItemThing"
      },
      "x-offset": "0x24",
      "x-c-type": "PTR32(ItemThing)"
    },
    "mode": {
      "description": "QUAD_ITEM_*",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x28",
      "x-c-type": "u32"
    },
    "unk_0x2C": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
