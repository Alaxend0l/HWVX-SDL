      "unk_0x10",
      "respawn",
      "timer",
      "record",
      "drawDist",
      "thing",
      "mode",
      "unk_0x2C",
      "id",
      "unk_0x32",
      "hasDrawDist",
      "aiPickup",
      "lo",
      "hi",
      "spawned",
      "defMode",
      "unk_0x3A"
    ]
  },
  "$defs": {
    "Vector4": {
