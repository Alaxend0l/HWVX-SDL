{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CarAHud",
  "description": "The HUD layouts of a car, by number of viewports.",
  "type": "object",
  "x-c-struct": "CarAHud",
  "x-header": "CarA.h",
  "x-size": "0x38",
  "x-hidden": [
    {
      "offset": "0x00",
      "size": 16,
      "c-name": "pad00",
      "note": "0 (car 16: f32 -0.35, 15 at 0x04); never read (GC, PC, PS2)"
    },
    {
      "offset": "0x14",
      "size": 4,
      "c-name": "pad14",
      "note": "0 in every car; never read (GC, PC, PS2)"
    },
    {
      "offset": "0x20",
      "size": 20,
      "c-name": "pad20",
      "note": "0, a pointer at 0x2C; never read (GC, PC, PS2)"
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path or URL of this schema"
    },
    "format_version": {
      "const": 1
    },
    "extends": {
      "type": "string",
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "CarAHud"
      },
      "description": "the object this one overrides (README \u00a710.3); fields left out, and the hidden ones, come from it"
    },
    "layout1": {
      "description": "one viewport",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x10",
      "x-c-type": "u32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "layout2": {
      "description": "two",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x18",
      "x-c-type": "u32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "layout4": {
      "description": "three or four",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x1C",
      "x-c-type": "u32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "stats": {
      "description": "vehicle select bars (InterfaceHudInfo.carStats)",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 4,
      "maxItems": 4,
      "x-offset": "0x34",
      "x-c-type": "u8[4]",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      },
      "x-hint": "bar lengths on the car select screen"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version"
  ],
  "if": {
    "required": [
      "extends"
    ]
  },
  "then": true,
  "else": {
    "required": [
      "layout1",
      "layout2",
      "layout4",
      "stats"
    ]
  }
}
