{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuadInstance",
  "description": "A placed object of a quadrant: drawn directly when its record is static, otherwise spawned as a destructible (type 3) while the quadrant is active. Trigger lists refer to these for \"destructible\" triggers.",
  "type": "object",
  "x-c-struct": "QuadInstance",
  "x-header": "World.h",
  "x-size": "0x40",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path or URL of this schema"
    },
    "format_version": {
      "const": 1
    },
    "extends": {
      "type": "string",
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "QuadInstance"
      },
      "description": "the object this one overrides (README \u00a710.3); fields left out, and the hidden ones, come from it"
    },
    "pos": {
      "$ref": "#/$defs/Vector4",
      "x-offset": "0x00",
      "x-c-type": "Vector4"
    },
    "quat": {
      "$ref": "#/$defs/Quaternion",
      "x-offset": "0x10",
      "x-c-type": "Quaternion"
    },
    "unk_0x20": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 4,
      "maxItems": 4,
      "x-offset": "0x20",
      "x-c-type": "u8[4]",
      "x-c-name": "pad20"
    },
    "record": {
      "description": "see THINGRECORD_IS_STATIC",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "ThingRecord"
      },
      "x-offset": "0x24",
      "x-c-type": "PTR32(ThingRecord)"
    },
    "drawDist": {
      "description": "used if hasDrawDist",
      "type": "number",
      "x-offset": "0x28",
      "x-c-type": "f32"
    },
    "thing": {
      "description": "the spawned destructible",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "Thing"
      },
      "x-offset": "0x2C",
      "x-c-type": "PTR32(Thing)"
    },
    "mode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x30",
      "x-c-type": "u32"
    },
    "hasDrawDist": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x34",
      "x-c-type": "u8"
    },
    "respawn": {
      "type": "integer",
      "minimum": -128,
      "maximum": 127,
      "x-offset": "0x35",
      "x-c-type": "s8"
    },
    "defMode": {
      "description": "mode at round start (GameRules_Init)",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x36",
      "x-c-type": "u8"
    },
    "unk_0x37": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 5,
      "maxItems": 5,
      "x-offset": "0x37",
      "x-c-type": "u8[5]",
      "x-c-name": "pad37"
    },
    "radius": {
      "description": "static ones: bounding radius, for culling",
      "type": "number",
      "x-offset": "0x3C",
      "x-c-type": "f32"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version"
  ],
  "if": {
    "required": [
      "extends"
    ]
  },
  "then": true,
  "else": {
    "required": [
      "pos",
      "quat",
      "unk_0x20",
      "record",
      "drawDist",
      "thing",
      "mode",
      "hasDrawDist",
      "respawn",
      "defMode",
      "unk_0x37",
      "radius"
    ]
  },
  "$defs": {
    "Vector4": {
      "title": "Vector4",
      "type": "object",
      "x-c-struct": "Vector4",
      "x-header": "common.h",
      "x-size": "0x10",
      "properties": {
        "x": {
          "type": "number",
          "x-offset": "0x00",
          "x-c-type": "f32"
        },
        "y": {
          "type": "number",
          "x-offset": "0x04",
          "x-c-type": "f32"
        },
        "z": {
          "type": "number",
          "x-offset": "0x08",
          "x-c-type": "f32"
        },
        "w": {
          "type": "number",
          "x-offset": "0x0C",
          "x-c-type": "f32"
        }
      },
      "additionalProperties": false
    },
    "Quaternion": {
      "title": "Quaternion",
      "type": "object",
      "x-c-struct": "Quaternion",
      "x-header": "common.h",
      "x-size": "0x10",
      "properties": {
        "x": {
          "type": "number",
          "x-offset": "0x00",
          "x-c-type": "f32"
        },
        "y": {
          "type": "number",
          "x-offset": "0x04",
          "x-c-type": "f32"
        },
        "z": {
          "type": "number",
          "x-offset": "0x08",
          "x-c-type": "f32"
        },
        "w": {
          "type": "number",
          "x-offset": "0x0C",
          "x-c-type": "f32"
        }
      },
      "additionalProperties": false
    }
  }
}
