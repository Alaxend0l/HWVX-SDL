{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TileCar",
  "description": "A car placed in the world (World_GetTileCar): spawned at level start or by ActionVehicleChangeMode. Trigger parameter lists refer to cars by their tile, so `car` is what \"vehicle\" triggers test.",
  "type": "object",
  "x-c-struct": "TileCar",
  "x-header": "World.h",
  "x-size": "0x60",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path or URL of this schema"
    },
    "format_version": {
      "const": 1
    },
    "extends": {
      "type": "string",
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "TileCar"
      },
      "description": "the object this one overrides (README \u00a710.3); fields left out, and the hidden ones, come from it"
    },
    "pos": {
      "$ref": "#/$defs/Vector4",
      "x-offset": "0x00",
      "x-c-type": "Vector4"
    },
    "rotX": {
      "description": "degrees, for SetOrientation",
      "type": "number",
      "x-offset": "0x10",
      "x-c-type": "f32"
    },
    "rotY": {
      "type": "number",
      "x-offset": "0x14",
      "x-c-type": "f32"
    },
    "rotZ": {
      "type": "number",
      "x-offset": "0x18",
      "x-c-type": "f32"
    },
    "unk_0x1C": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 8,
      "maxItems": 8,
      "x-offset": "0x1C",
      "x-c-type": "u8[8]",
      "x-c-name": "pad1C"
    },
    "info": {
      "description": "the vehicle; AI scripts per difficulty at 0x90",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "struct CarAInfo"
      },
      "x-offset": "0x24",
      "x-c-type": "PTR32(struct CarAInfo)",
      "x-union-alternatives": [
        "aiScripts"
      ]
    },
    "car": {
      "description": "the spawned car, NULL if none",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "struct CarA"
      },
      "x-offset": "0x28",
      "x-c-type": "PTR32(struct CarA)"
    },
    "mode": {
      "description": "last ActionVehicleChangeMode mode",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x2C",
      "x-c-type": "u32"
    },
    "vehicle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x30",
      "x-c-type": "u32"
    },
    "dynamic": {
      "description": "nonzero: not spawned by mode 1/10; AIPlayerParams.dynamic",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x34",
      "x-c-type": "u8"
    },
    "port": {
      "description": "1-4: human player slot; AI cars spawn only when > 4",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x35",
      "x-c-type": "u8"
    },
    "unk_0x36": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x36",
      "x-c-type": "u8",
      "x-c-name": "pad36"
    },
    "maxVehicle": {
      "description": "AI cars pick a vehicle in 0..maxVehicle",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x37",
      "x-c-type": "u8"
    },
    "nearDist": {
      "description": "AI ranges",
      "type": "number",
      "x-offset": "0x38",
      "x-c-type": "f32"
    },
    "farDist": {
      "type": "number",
      "x-offset": "0x3C",
      "x-c-type": "f32"
    },
    "scripts": {
      "description": "AI script per difficulty, 0: the vehicle's",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "minItems": 4,
      "maxItems": 4,
      "x-offset": "0x40",
      "x-c-type": "u32[4]"
    },
    "item2": {
      "description": "a second item it starts with (LoadWorldProcess)",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "ItemRecord"
      },
      "x-offset": "0x50",
      "x-c-type": "PTR32(ItemRecord)"
    },
    "item": {
      "description": "wildcard the car starts with, NULL: none",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "ItemRecord"
      },
      "x-offset": "0x54",
      "x-c-type": "PTR32(ItemRecord)"
    },
    "health": {
      "description": "fraction of the maximum, kept across DD Rescue missions (GameSettings_RestoreGameData)",
      "type": "number",
      "x-offset": "0x58",
      "x-c-type": "f32"
    },
    "respawn": {
      "description": "freed (car = NULL) when its AI car is removed",
      "type": "integer",
      "minimum": -128,
      "maximum": 127,
      "x-offset": "0x5C",
      "x-c-type": "s8"
    },
    "item2ID": {
      "description": "item pack ids of item2 and item, 0xFF: none",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x5D",
      "x-c-type": "u8"
    },
    "itemID": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x5E",
      "x-c-type": "u8"
    },
    "spawned": {
      "description": "nonzero: always spawned at round start; DD Rescue sets it for cars that were spawned when the mission was left",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x5F",
      "x-c-type": "u8"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version"
  ],
  "if": {
    "required": [
      "extends"
    ]
  },
  "then": true,
  "else": {
    "required": [
      "pos",
      "rotX",
      "rotY",
      "rotZ",
      "unk_0x1C",
      "info",
      "car",
      "mode",
      "vehicle",
      "dynamic",
      "port",
      "unk_0x36",
      "maxVehicle",
      "nearDist",
      "farDist",
      "scripts",
      "item2",
      "item",
      "health",
      "respawn",
      "item2ID",
      "itemID",
      "spawned"
    ]
  },
  "$defs": {
    "Vector4": {
      "title": "Vector4",
      "type": "object",
      "x-c-struct": "Vector4",
      "x-header": "common.h",
      "x-size": "0x10",
      "properties": {
        "x": {
          "type": "number",
          "x-offset": "0x00",
          "x-c-type": "f32"
        },
        "y": {
          "type": "number",
          "x-offset": "0x04",
          "x-c-type": "f32"
        },
        "z": {
          "type": "number",
          "x-offset": "0x08",
          "x-c-type": "f32"
        },
        "w": {
          "type": "number",
          "x-offset": "0x0C",
          "x-c-type": "f32"
        }
      },
      "additionalProperties": false
    }
  }
}
