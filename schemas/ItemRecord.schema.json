{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemRecord",
  "description": "The item's description in the data pack.",
  "type": "object",
  "x-c-struct": "ItemRecord",
  "x-header": "ItemThing.h",
  "x-size": "0x3C",
  "x-hidden": [
    {
      "offset": "0x01",
      "size": 1,
      "c-name": "pad01",
      "note": "1 in most GameCube items; never read (GC, PC, PS2)"
    },
    {
      "offset": "0x04",
      "size": 8,
      "c-name": "pad04",
      "note": "u8 1 or 0, 3 zero bytes, s32 800 (5000, 300, 1000... ms?); never read (GC, PC, PS2)"
    },
    {
      "offset": "0x14",
      "size": 4,
      "c-name": "pad14",
      "note": "0 in every GameCube item; never read (GC, PC, PS2)"
    },
    {
      "offset": "0x2C",
      "size": 4,
      "c-name": "pad2C",
      "note": "pointer in item 51 only; never read (GC, PC, PS2)"
    },
    {
      "offset": "0x34",
      "size": 4,
      "c-name": "pad34",
      "note": "pointer in some items; never read (GC, PC, PS2)"
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path or URL of this schema"
    },
    "format_version": {
      "const": 1
    },
    "extends": {
      "type": "string",
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "ItemRecord"
      },
      "description": "the object this one overrides (README \u00a710.3); fields left out, and the hidden ones, come from it"
    },
    "type": {
      "description": "ITEM_TYPE_*",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-offset": "0x00",
      "x-c-type": "u8",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "value": {
      "description": "points, or the car's pickup slave set",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-offset": "0x02",
      "x-c-type": "u16",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "radius": {
      "description": "pickup radius",
      "type": "number",
      "x-offset": "0x0C",
      "x-c-type": "f32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "height": {
      "description": "spawned this high above its point",
      "type": "number",
      "x-offset": "0x10",
      "x-c-type": "f32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "spinMin": {
      "description": "random spin speed range, degrees",
      "type": "number",
      "x-offset": "0x18",
      "x-c-type": "f32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "?",
        "pc": "yes"
      }
    },
    "spinMax": {
      "type": "number",
      "x-offset": "0x1C",
      "x-c-type": "f32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "names": {
      "description": "name string table ([0]: the weapon name)",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "PTR32(char)"
      },
      "x-offset": "0x20",
      "x-c-type": "PTR32(PTR32(char))",
      "x-confidence": "certain",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "pickupDebris": {
      "description": "effect spawned when picked up, 0: none",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "void"
      },
      "x-offset": "0x24",
      "x-c-type": "u32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "spawnDebris": {
      "description": "effect spawned when it appears, 0: none",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-offset": "0x28",
      "x-c-type": "u32",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "?",
        "pc": "?"
      }
    },
    "weapon": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(base://[A-Za-z0-9_]+/[A-Za-z0-9_]+/[A-Za-z0-9_]+/(?:[a-z0-9]+:)?[0-9]+|uid://[0-9a-z]{1,13})(/[A-Za-z0-9_]+)*$",
      "x-link": {
        "kind": "object",
        "target": "WeaponInfo"
      },
      "x-offset": "0x30",
      "x-c-type": "PTR32(WeaponInfo)",
      "x-confidence": "certain",
      "x-read": {
        "gc": "yes",
        "ps2": "yes",
        "pc": "yes"
      }
    },
    "sharedSlaves": {
      "description": "Thing_DrawSharedSlaves triggers",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 4,
      "maxItems": 4,
      "x-offset": "0x38",
      "x-c-type": "u8[4]",
      "x-confidence": "likely",
      "x-read": {
        "gc": "yes",
        "ps2": "?",
        "pc": "?"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version"
  ],
  "if": {
    "required": [
      "extends"
    ]
  },
  "then": true,
  "else": {
    "required": [
      "type",
      "value",
      "radius",
      "height",
      "spinMin",
      "spinMax",
      "names",
      "pickupDebris",
      "spawnDebris",
      "weapon",
      "sharedSlaves"
    ]
  }
}
