// A sample Challenge on Joyride world 4, which retail has no challenge on (xdlrs level new --mode challenge
// --world worlds_\sp_\joyride_\world4): the template's gears, key and their objectives removed; the challenge's
// own screens (modeWorld: Challenge 1's pack beside the world): its intro box with the briefing line, its start,
// Objective Complete when the goal down the road is reached before the 30 s clock, else Objective Failed.
{
  "$schema": "../../../schemas/Level.schema.json",
  "format_version": 1,
  "id": "uid://joyridedash",
  "name": "Joyride Dash",
  "mode": "challenge",
  "extends": "base://mcp/track/39",
  "world": "worlds_\\sp_\\joyride_\\world4",
  "unlocked": true,
  "baseTriggers": [
    6
  ],
  "remove": {
    "items": [
      "base://world4/world_0/World/0/quads/3/contents/items/0",
      "base://world4/world_0/World/0/quads/4/contents/items/0",
      "base://world4/world_0/World/0/quads/4/contents/items/1",
      "base://world4/world_0/World/0/quads/9/contents/items/0",
      "base://world4/world_0/World/0/quads/10/contents/items/0",
      "base://world4/world_0/World/0/quads/12/contents/items/0",
      "base://world4/world_0/World/0/quads/13/contents/items/0",
      "base://world4/world_0/World/0/quads/13/contents/items/1",
      "base://world4/world_0/World/0/quads/14/contents/items/0",
      "base://world4/world_0/World/0/quads/19/contents/items/0",
      "base://world4/world_0/World/0/quads/21/contents/items/0"
    ],
    "objectives": [
      "base://world4/world_0/World/0/objectives/0",
      "base://world4/world_0/World/0/objectives/1"
    ]
  },
  "modeWorld": "worlds_\\sp_\\chal1_\\ch1_l2",
  "objectives": {
    "brief": {
      "text": "level://strings/brief",
      "kind": "none",
      "done": "level://variables/briefed/to",
      "hud": 1
    }
  },
  "strings": {
    "blank": "     ",
    "brief": "Reach the goal before the clock runs out!"
  },
  "variables": {
    "done": 0,
    "briefed": 0,
    "goal": 0
  },
  "timers": {
    "clock": {
      "time": 30000,
      "countUp": 0,
      "type": 12
    }
  },
  "triggers": [
    "start",
    "go",
    "won",
    "timeout",
    "goal"
  ],
  "description": "Down the road to the goal before the clock runs out: a challenge on Joyride world 4.",
  "volumes": {
    "goal": {
      "center": [
        -2452,
        -166,
        -2778
      ],
      "radius": 50
    }
  },
  "test": {
    "memory": [
      "level: uid://joyridedash: 11 base items and 2 base objectives removed",
      "level: the mode's screens from worlds_\\sp_\\chal1_\\ch1_l2"
    ],
    "win": [
      "progression: the level ends: won (sequence 0)"
    ],
    "lose": [
      "progression: the level ends: lost (sequence 0)"
    ]
  }
}
