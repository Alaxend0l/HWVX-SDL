{
  "$schema": "../../../../schemas/Trigger.schema.json",
  "format_version": 1,
  "type": "airbox_entered",
  "param": {
    "volumes": [
      "level://volumes/goal"
    ],
    "cars": [
      "base://world4/world_0/World/0/tileCars/0"
    ]
  },
  "actions": [
    {
      "type": "variable_change_value",
      "data": {
        "op": "set",
        "variables": [
          "level://variables/goal"
        ],
        "value": {
          "const": 1
        }
      }
    }
  ]
}
