{
  "$schema": "../../../../schemas/Trigger.schema.json",
  "format_version": 1,
  "type": "variable_value_check",
  "param": {
    "variables": [
      "level://variables/goal"
    ],
    "value": {
      "const": 1
    },
    "op": "equal"
  },
  "conditions": [
    {
      "type": "variable_value_check",
      "param": {
        "variables": [
          "level://variables/done"
        ],
        "value": {
          "const": 0
        },
        "op": "equal"
      }
    }
  ],
  "actions": [
    {
      "type": "variable_change_value",
      "data": {
        "op": "set",
        "variables": [
          "level://variables/done"
        ],
        "value": {
          "const": 1
        }
      }
    },
    {
      "type": "variable_change_value",
      "data": {
        "op": "set",
        "variables": [
          "level://variables/briefed"
        ],
        "value": {
          "const": 1
        }
      }
    },
    {
      "type": "timer_change_mode",
      "data": {
        "show": "show",
        "run": "pause",
        "timers": [
          "level://timers/clock"
        ]
      }
    },
    {
      "type": "vehicle_change_control",
      "data": {
        "mode": "lock_control",
        "unused": 0,
        "cars": [
          "base://world2/world_0/World/0/tileCars/0"
        ]
      },
      "delayInit": 1000
    },
    {
      "type": "camera_set_targets",
      "data": {
        "player": 0,
        "camera": {
          "kind": "orbit",
          "fov": 105,
          "radius": 18,
          "height": 0.5,
          "speed": 1,
          "around": {
            "kind": "car",
            "car": "base://world2/world_0/World/0/tileCars/0",
            "offset": [
              10,
              10,
              0
            ]
          },
          "at": {
            "kind": "car",
            "car": "base://world2/world_0/World/0/tileCars/0",
            "offset": [
              0,
              0,
              0
            ]
          }
        },
        "end": 31
      }
    },
    {
      "type": "hud_change_mode",
      "data": {
        "unused": 1,
        "on": 0
      },
      "delayInit": 200
    },
    {
      "type": "interface_play",
      "data": {
        "interface": "base://world1l1/world_0/trigger/35/actions/0/data/p0"
      },
      "delayInit": 4000
    }
  ]
}
