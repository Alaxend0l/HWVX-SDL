{
  "$schema": "../../../../schemas/Trigger.schema.json",
  "format_version": 1,
  "type": "level_start",
  "actions": [
    {
      "type": "timer_change_mode",
      "data": {
        "show": "show",
        "run": "resume",
        "timers": [
          "level://timers/clock"
        ]
      }
    },
    {
      "type": "print_debug_string",
      "data": {
        "what": 4,
        "countdown": 60,
        "value": "level://strings/o1"
      }
    }
  ]
}
