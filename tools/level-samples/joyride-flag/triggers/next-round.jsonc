{
  "$schema": "../../../../schemas/Trigger.schema.json",
  "format_version": 1,
  "type": "interface_end",
  "param": {
    "interface": "base://bat1_l1/world_0/trigger/0/param/p0"
  },
  "actions": [
    {
      "type": "reset_game_round",
      "data": {
        "resetMotion": 1,
        "resetPosition": 1,
        "jettison": 1
      },
      "count": "always"
    },
    {
      "type": "hud_change_mode",
      "data": {
        "unused": 1,
        "on": 1
      },
      "delayInit": 1000,
      "count": "always"
    },
    {
      "type": "vehicle_change_control",
      "data": {
        "mode": "unlock_control",
        "unused": 0,
        "cars": [
          "base://world1/world_0/World/0/tileCars/0",
          "level://starts/rival"
        ]
      },
      "delayInit": 3500,
      "count": "always"
    },
    {
      "type": "interface_play",
      "data": {
        "interface": "base://bat1_l1/world_0/trigger/0/actions/3/data/p0"
      },
      "count": "always"
    },
    {
      "type": "timer_change_mode",
      "data": {
        "show": "show",
        "run": "resume",
        "timers": [
          "level://timers/clock"
        ]
      },
      "delayInit": 3500,
      "count": "always"
    },
    {
      "type": "music_change",
      "data": {
        "vol": 1,
        "volTime": 0,
        "pitch": 1,
        "pitchTime": 0,
        "tempo": 1,
        "tempoTime": 0,
        "orderMode": "order_jump",
        "order": 31,
        "orderType": 40,
        "tracks": []
      },
      "count": "always"
    }
  ]
}
