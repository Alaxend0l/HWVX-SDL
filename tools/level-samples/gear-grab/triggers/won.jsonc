{
  "$schema": "../../../../schemas/Trigger.schema.json",
  "format_version": 1,
  "type": "variable_value_check",
  "param": {
    "variables": [
      "level://variables/got"
    ],
    "value": {
      "const": 2
    },
    "op": "equal"
  },
  "conditions": [
    {
      "type": "variable_value_check",
      "param": {
        "variables": [
          "level://variables/done"
        ],
        "value": {
          "const": 0
        },
        "op": "equal"
      }
    }
  ],
  "mode": "all",
  "actions": [
    {
      "type": "variable_change_value",
      "data": {
        "op": "set",
        "variables": [
          "level://variables/done"
        ],
        "value": {
          "const": 1
        }
      }
    },
    {
      "type": "print_debug_string",
      "data": {
        "what": 4,
        "countdown": 60,
        "value": "level://strings/two"
      }
    },
    {
      "type": "end_level",
      "data": {
        "result": 4,
        "arg": 0
      },
      "delayInit": 2000
    }
  ]
}
