{
  "$schema": "../../../../schemas/Trigger.schema.json",
  "format_version": 1,
  "type": "airbox_entered",
  "param": {
    "volumes": [
      "level://volumes/finish"
    ],
    "cars": [
      "base://race1l2/world_0/World/0/tileCars/1"
    ]
  },
  "conditions": [
    {
      "type": "variable_value_check",
      "param": {
        "variables": [
          "level://variables/done"
        ],
        "value": {
          "const": 0
        },
        "op": "equal"
      }
    }
  ],
  "actions": [
    {
      "type": "variable_change_value",
      "data": {
        "op": "set",
        "variables": [
          "level://variables/done"
        ],
        "value": {
          "const": 1
        }
      }
    },
    {
      "type": "round_complete",
      "data": {
        "player": 2
      }
    },
    {
      "type": "interface_play",
      "data": {
        "interface": "base://race1l2/world_0/trigger/11/actions/1/data/p0"
      }
    }
  ]
}
