{
  "$schema": "../../../../schemas/Trigger.schema.json",
  "format_version": 1,
  "type": "level_start",
  "actions": [
    {
      "type": "interface_play",
      "data": {
        "interface": "base://race1l2/world_0/trigger/26/actions/1/data/p0"
      },
      "delayInit": 500,
      "count": "always"
    },
    {
      "type": "vehicle_change_control",
      "data": {
        "mode": "lock_control",
        "unused": 0,
        "cars": [
          "base://world1/world_0/World/0/tileCars/0",
          "level://starts/lane2",
          "level://starts/lane3",
          "level://starts/lane4"
        ]
      },
      "count": "always"
    },
    {
      "type": "vehicle_change_control",
      "data": {
        "mode": "unlock_control",
        "unused": 0,
        "cars": [
          "base://world1/world_0/World/0/tileCars/0",
          "level://starts/lane2",
          "level://starts/lane3",
          "level://starts/lane4"
        ]
      },
      "delayInit": 4500,
      "count": "always"
    },
    {
      "type": "hud_change_mode",
      "data": {
        "unused": 1,
        "on": 0
      },
      "count": "always"
    },
    {
      "type": "hud_change_mode",
      "data": {
        "unused": 1,
        "on": 1
      },
      "delayInit": 4500,
      "count": "always"
    },
    {
      "type": "timer_change_mode",
      "data": {
        "show": "show",
        "run": "pause",
        "timers": [
          "level://timers/clock"
        ]
      },
      "count": "always"
    },
    {
      "type": "timer_change_mode",
      "data": {
        "show": "show",
        "run": "resume",
        "timers": [
          "level://timers/clock"
        ]
      },
      "delayInit": 4500,
      "count": "always"
    },
    {
      "type": "code_variable_modify_value",
      "data": {
        "op": "set",
        "var": {
          "var": 300,
          "arg": 0
        },
        "value": {
          "const": 1
        }
      },
      "count": "always"
    }
  ]
}
