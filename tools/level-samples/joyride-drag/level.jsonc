    "go",
    "finish1",
    "finish2",
    "finish3",
    "finish4",
    "timeout",
    "next-round",
    "won",
    "lost"
  ],
  "description": "Four lanes down the road from the start: beat the clock to the finish.",
  "patches": {
    "base://world1/world_0/World/0/tileCars/0": {
      "pos/x": -3674
    }
  },
  "starts": {
