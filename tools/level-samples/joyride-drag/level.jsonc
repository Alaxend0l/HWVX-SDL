      "base://world1/world_0/World/0/quads/19/contents/items/4"
    ],
    "objectives": [
      "base://world1/world_0/World/0/objectives/0",
      "base://world1/world_0/World/0/objectives/1"
    ]
  },
  "objectives": {
    "brief": {
      "text": "level://strings/brief",
      "kind": "none",
      "done": "level://variables/briefed/to",
      "hud": 1
    }
  },
  "rules": {
    "mode": "none",
