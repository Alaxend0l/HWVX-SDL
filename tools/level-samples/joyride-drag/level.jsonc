// A sample Drag Race on Joyride world 1 (xdlrs level new --mode drag --world worlds_\sp_\joyride_\world1): the
// template's gears, key and their objectives removed; four lanes (the player's start moved into the first by a
// patch, three AI starts of its own: port 0), a finish down the road, a round_complete trigger per car. On a
// Joyride world the AI has no drag scripts: its cars drive the vehicle's own AI on the world's roads, not their
// lane; the 20 s clock is the opponent that wins it for player 2 (the HUD's round clock).
{
  "$schema": "../../../schemas/Level.schema.json",
  "format_version": 1,
  "id": "uid://joyridedrag",
  "name": "Joyride Drag",
  "mode": "drag",
  "extends": "base://mcp/track/29",
  "world": "worlds_\\sp_\\joyride_\\world1",
  "unlocked": true,
  "baseTriggers": [
    0,
